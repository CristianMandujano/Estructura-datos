<ui version="4.0">
 <class>DialogoImpresion</class>
 <widget class="QDialog" name="DialogoImpresion">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>550</width>
    <height>420</height>
