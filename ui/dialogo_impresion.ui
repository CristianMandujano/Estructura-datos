  <property name="windowTitle">
   <string>Simulación de Cola de Impresión</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* Ventana principal del diálogo */
QDialog {
    background-color: #F8FAFC;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
}

/* Campos de texto (QLineEdit) */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #1E293B;
}

QLineEdit:focus {
    border: 2px solid #2563EB; /* Borde azul al enfocar */
}

/* Tabla de trabajos pendientes (QTableWidget) */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    color: #1E293B;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #EDF2F7;
    color: #334155;
    font-weight: bold;
    padding: 6px;
    border: none;
    border-bottom: 2px solid #CBD5E1;
}

/* Botón 'Agregar a la cola' (Acción principal) */
QPushButton#btn_agregar {
    background-color: #2563EB; /* Azul moderno */
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btn_agregar:hover {
    background-color: #1D4ED8;
}

QPushButton#btn_agregar:pressed {
    background-color: #1E40AF;
}

/* Botón 'Imprimir siguiente' (Acción de procesamiento) */
QPushButton#btn_imprimir {
    background-color: #16A34A; /* Verde impresión */
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btn_imprimir:hover {
    background-color: #15803D;
}

QPushButton#btn_imprimir:pressed {
    background-color: #166534;
}

/* Botón 'Consultar frente' */
QPushButton#btn_frente {
    background-color: #E2E8F0;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btn_frente:hover {
    background-color: #CBD5E1;
}

/* Botones genéricos de respaldo */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    color: #334155;
}

/* Etiquetas generales */
QLabel {
    color: #334155;
    font-size: 13px;
}

/* Etiqueta del total de trabajos pendientes */
QLabel#lbl_total_pendientes {
    font-weight: bold;
    color: #0F172A;
    font-size: 13px;
}

/* Área de mensajes y estado */
QLabel#lbl_mensajes {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 8px;
    color: #1E293B;
    font-size: 12px;
}</string>
  </property>
